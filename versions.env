# The versions the libnode of every system is built from, upgraded together (read by scripts/build.mjs and the
# workflows; KEY=VALUE lines, no quotes)

# Node.js: built from its sources for HarmonyOS; Android and iOS are built from the recipe below, which patches the
# same version (its upstream-base.txt)
NODE_VERSION=24.20.0
# A build of the same version of Node.js made again (other patches, other toolchains): the release is then
# v<NODE_VERSION>-<REVISION>
REVISION=

# The patch recipe of digidem/nodejs-mobile (Android, iOS): the commit releasing nodejs-mobile 24.20.0-0
RECIPE_COMMIT=7c55423d731f7fec83ac52ab158901ce20a57356

# Android: the NDK, and the minimum API level of the library
ANDROID_NDK_VERSION=r27d
ANDROID_API=24

# HarmonyOS: the LLVM 19 of OpenHarmony (its toolchain and its sysroot, for Linux x86_64). The URL is a daily build,
# which the CI of OpenHarmony removes some day: the workflow Toolchains copies it into the release toolchains of this
# repository, downloaded first
OHOS_LLVM_URL=https://cidownload.openharmony.cn/version/Daily_Version/LLVM-19/20261101_061419/version-Daily_Version-LLVM-19-20261101_061419-LLVM-19.tar.gz
OHOS_LLVM_SHA256=764621be8b4bb86f14953421e4a812aaaba8265b682ac02a9cc7eda06e7fe0ff
OHOS_LLVM_MIRROR=https://github.com/lakutata/libnode/releases/download/toolchains/ohos-llvm-19-20261101_061419.tar.gz
